# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://dingochat:dingochat@localhost:5432/dingochat?schema=public

# Auth: use at least 32 random bytes in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Firebase Admin: either use Application Default Credentials, or set
# FIREBASE_PROJECT_ID and FIREBASE_SERVICE_ACCOUNT_JSON (a JSON string).
# FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Required only when using the Firestore emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
