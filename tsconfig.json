{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022"],
    "rootDir": "src", "outDir": "dist", "strict": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "declaration": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist", "tests", "prisma/seed.ts"]
}
